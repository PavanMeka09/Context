FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for Playwright and Chromium
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    libxss1 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY server/crawler_service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY server/crawler_service/ ./server/crawler_service/

EXPOSE 8083

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8083/health')" || exit 1

CMD ["python3", "server/crawler_service/main.py"]
