# Context AI Production Environment Variables

# Companion Server HTTP Port
PORT=3001

# Allowed CORS Origins (comma-separated or * for wildcard)
CORS_ORIGIN=*

# SearXNG Engine URL for Web Search
SEARXNG_URL=http://localhost:8082

# Custom Storage Directory (Defaults to ~/.context-ai)
# DATA_DIR=/path/to/data

# Optional Puppeteer Executable Path Override
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
