FROM node:22-slim

# Install Chromium and required system dependencies for Puppeteer
RUN apt-get update && apt-get install -y \
    chromium \
    python3 \
    python3-pip \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    libxss1 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Skip Puppeteer's bundled Chromium download; we use system Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

 # Companion only needs server runtime deps — avoid installing the full frontend tree
COPY package.json ./
RUN node -e "\
const fs=require('fs');\
const pkg=JSON.parse(fs.readFileSync('package.json','utf8'));\
const keep=new Set(['express','cors','playwright','playwright-extra','puppeteer-extra-plugin-stealth','ws','node-cron','typescript']);\
pkg.dependencies=Object.fromEntries(Object.entries(pkg.dependencies||{}).filter(([k])=>keep.has(k)));\
delete pkg.devDependencies;\
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));\
" \
  && npm install --omit=dev --no-audit --no-fund

# Copy backend companion files
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt || true

COPY server.cjs ./
COPY server/ ./server/

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/api/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["node", "server.cjs"]
